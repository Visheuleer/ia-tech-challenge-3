APP_NAME=Medical Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development

DATABASE_URL=sqlite:///./data/medical_assistant.db

PROTOCOLS_PATH=data/raw/protocols
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LLM_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_ADAPTER_PATH=artifacts/models/hypertension-assistant
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.2